{
  "name": "tutelas_backend",
  "version": "0.1.0",
  "private": true,
  "description": "GPA Legal: gestión de tutelas, acciones de cumplimiento y PQRS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "worker": "nodemon --watch src src/worker.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "start:worker": "node ./dist/worker.js",
    "tipos": "tsc --noEmit",
    "crear-admin": "ts-node --transpile-only src/scripts/crearAdmin.ts",
    "correo-prueba": "ts-node --transpile-only src/scripts/correoPrueba.ts",
    "leer-buzon": "ts-node --transpile-only src/scripts/leerBuzon.ts",
    "limpiar-buzon": "ts-node --transpile-only src/scripts/limpiarBuzon.ts"
  },
  "author": "Diego Alejandro Mora",
  "license": "UNLICENSED",
  "dependencies": {
    "@azure/msal-node": "^7.2.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.2",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
