# Servidor
PORT=4100
# 127.0.0.1 cuando hay un Nginx delante
HOST=0.0.0.0
NODE_ENV=development
# Dirección pública del frontend (CORS y enlaces de los correos)
URL_FRONTEND=http://localhost:3100

# Base de datos: el mismo servidor Postgres de Nodex, pero una base propia
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=gpa_legal

# Redis: un número de base distinto al de Nodex para no compartir colas
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=5

# Sesión de la app (login propio con correo y contraseña). Una clave larga y propia, no la de Nodex
JWT_SECRET=

# Entra ID: SOLO para leer y enviar correo del buzón de tutelas (los usuarios no entran con 365)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Buzón compartido de tutelas (la app solo puede leer este, por la política de acceso)
BUZON_CORREO=
# Alias por etapa: si el correo no trae el encabezado de la regla de Exchange, se usa el alias
ALIAS_ACCION=
ALIAS_IMPUGNACION=
ALIAS_CUMPLIMIENTO=
# Cada cuántos segundos se consulta el buzón
BUZON_INTERVALO_SEGUNDOS=120
# false = no lee el buzón (desarrollo sin credenciales)
BUZON_ACTIVO=false
# La primera lectura toma solo los correos desde esta fecha (vacío = desde hoy)
BUZON_LEER_DESDE=2026-11-17

# Azure Blob para adjuntos y escritos
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=tutelas
