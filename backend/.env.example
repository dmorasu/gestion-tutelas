# Servidor
PORT=4100
# 127.0.0.1 cuando hay un Nginx delante
HOST=0.0.0.0
NODE_ENV=development
# Dirección pública del frontend (CORS y enlaces de los correos)
URL_FRONTEND=http://localhost:3100

# Base de datos: el mismo servidor Postgres de Nodex, pero una base propia
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=gpa_legal

# Redis: un número de base distinto al de Nodex para no compartir colas
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=5

# Sesión de la app (login propio con correo y contraseña). Una clave larga y propia, no la de Nodex
JWT_SECRET=

# Entra ID: SOLO para leer y enviar correo de los buzones del servicio (los usuarios no entran con 365)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Los tres buzones del servicio, cada uno con su función (la app solo puede leer estos, por la
# política de acceso). Uno vacío = no se lee ni se envía desde él
#   asignaciones: entran las asignaciones y sale la confirmación de recibido con el número interno
#   insumos: salen las solicitudes de insumos y entran las respuestas
#   entregas: salen las entregas V1 y V2 y entran el acuse, la aprobación o la devolución
BUZON_ASIGNACIONES=
BUZON_INSUMOS=
BUZON_ENTREGAS=
# true = los correos de salida se envían de verdad. Cualquier otro valor: quedan SIMULADOS
# (se registran en el caso, pero no salen). Encenderlo solo cuando las plantillas estén aprobadas
CORREO_ENVIO_ACTIVO=false
# Primer bloque del asunto de los correos de salida (convención del cliente). Solo se usa al crear
# el parámetro la primera vez; después se cambia en la pantalla de Parámetros
PREFIJO_ASUNTO=

# Cada cuántos segundos se consulta el buzón
BUZON_INTERVALO_SEGUNDOS=120
# false = no lee el buzón (desarrollo sin credenciales)
BUZON_ACTIVO=false
# La primera lectura toma solo los correos desde esta fecha (vacío = desde hoy)
BUZON_LEER_DESDE=2026-11-17

# SharePoint: repositorio de los expedientes (manual §23). La app de Entra necesita el permiso
# Sites.Selected y que el administrador le dé acceso de escritura solo a este sitio
#   SHAREPOINT_SITIO=empresa.sharepoint.com:/sites/Tutelas
#   SHAREPOINT_BIBLIOTECA=   (vacío = la biblioteca de documentos del sitio)
SHAREPOINT_SITIO=
SHAREPOINT_BIBLIOTECA=
# Sin SharePoint, los archivos van a esta carpeta (solo para desarrollo; vacío = backend/almacen-local)
ALMACEN_LOCAL=
